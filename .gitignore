# Local settings contain machine-specific model and executable paths.
settings.json
runtime_profiles.local.json

# Benchmarks and server logs are generated locally.
results/
*.log

# Python caches and local environments.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Model weights should never be committed to the source repository.
models/
*.gguf
*.safetensors

# Downloaded, machine-specific llama.cpp runtimes (keep DLLs with their EXE).
runtimes/*/
runtimes/*.zip

# Local secrets.
.env
.env.*

# Desktop build and isolated QA data.
.test-data/
.test-artifacts/
*.egg-info/
build/
dist/
